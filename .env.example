# ============================================================
# MacroLibre — variables de entorno
# ============================================================
# Copiá este archivo a `.env.local` (no commitear .env.local)
# y rellená cada valor.
# ============================================================

# Base de datos Postgres (Neon)
# Lo conseguís en: https://console.neon.tech → tu proyecto → Connection string
DATABASE_URL="postgresql://user:pass@host.neon.tech/dbname?sslmode=require"

# NextAuth — generá un secret con: openssl rand -base64 32
AUTH_SECRET="reemplaza_con_un_string_random_largo"

# URL del sitio. En local: http://localhost:3000. En prod: https://macrolibre.com
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
# Lo conseguís en: https://console.cloud.google.com
# APIs & Services → Credentials → Create credentials → OAuth client ID → Web application
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (+ tu URL de prod)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (email magic link)
# Lo conseguís en: https://resend.com/api-keys
# Free tier: 100 emails/día. Validá tu dominio para enviar desde @macrolibre.com.
AUTH_RESEND_KEY=""
AUTH_RESEND_FROM="MacroLibre <onboarding@resend.dev>"
